#include <stdio.h>
#include <string.h>

#define MAX_ALUNOS 100

struct Aluno {
    int id;
    char nome[50];
    int idade;
    char turma[30];
};

struct Aluno alunos[MAX_ALUNOS];
int total = 0;

// FUNÇÃO PARA CADASTRAR
void cadastrarAluno() {

    if (total >= MAX_ALUNOS) {
        printf("\nLimite de alunos atingido!\n");
        return;
    }

    alunos[total].id = total + 1;

    printf("\n=== CADASTRAR ALUNO ===\n");

    printf("Nome: ");
    getchar();
    fgets(alunos[total].nome, 50, stdin);
    alunos[total].nome[strcspn(alunos[total].nome, "\n")] = '\0';

    do {
        printf("Idade (minimo 18): ");
        scanf("%d", &alunos[total].idade);

        if (alunos[total].idade < 18) {
            printf("Idade invalida!\n");
        }

    } while (alunos[total].idade < 18);

    printf("Turma: ");
    getchar();
    fgets(alunos[total].turma, 30, stdin);
    alunos[total].turma[strcspn(alunos[total].turma, "\n")] = '\0';

    total++;

    printf("\nAluno cadastrado com sucesso!\n");
}

// FUNÇÃO PARA LISTAR
void listarAlunos() {

    int i;

    if (total == 0) {
        printf("\nNenhum aluno cadastrado.\n");
        return;
    }

    printf("\n=========== TABELA DE ALUNOS ===========\n");

    printf("%-5s %-25s %-10s %-20s\n",
           "ID", "NOME", "IDADE", "TURMA");

    printf("-----------------------------------------------------------\n");

    for (i = 0; i < total; i++) {

        printf("%-5d %-25s %-10d %-20s\n",
               alunos[i].id,
               alunos[i].nome,
               alunos[i].idade,
               alunos[i].turma);
    }
}

// FUNÇÃO PARA LOCALIZAR
void localizarAluno() {

    char busca[50];
    int i;
    int encontrado = 0;

    printf("\nDigite o nome do aluno: ");
    getchar();
    fgets(busca, 50, stdin);
    busca[strcspn(busca, "\n")] = '\0';

    for (i = 0; i < total; i++) {

        if (strcmp(busca, alunos[i].nome) == 0) {

            printf("\nAluno encontrado!\n");

            printf("ID: %d\n", alunos[i].id);
            printf("Nome: %s\n", alunos[i].nome);
            printf("Idade: %d\n", alunos[i].idade);
            printf("Turma: %s\n", alunos[i].turma);

            encontrado = 1;
        }
    }

    if (!encontrado) {
        printf("\nAluno nao encontrado.\n");
    }
}

// FUNÇÃO PARA ALTERAR
void alterarAluno() {

    int id;
    int i;

    printf("\nDigite o ID do aluno que deseja alterar: ");
    scanf("%d", &id);

    for (i = 0; i < total; i++) {

        if (alunos[i].id == id) {

            printf("\nNovo nome: ");
            getchar();
            fgets(alunos[i].nome, 50, stdin);
            alunos[i].nome[strcspn(alunos[i].nome, "\n")] = '\0';

            printf("Nova idade: ");
            scanf("%d", &alunos[i].idade);

            printf("Nova turma: ");
            getchar();
            fgets(alunos[i].turma, 30, stdin);
            alunos[i].turma[strcspn(alunos[i].turma, "\n")] = '\0';

            printf("\nAluno alterado com sucesso!\n");

            return;
        }
    }

    printf("\nAluno nao encontrado.\n");
}

// FUNÇÃO PARA EXCLUIR
void excluirAluno() {

    int id;
    int i, j;

    printf("\nDigite o ID do aluno que deseja excluir: ");
    scanf("%d", &id);

    for (i = 0; i < total; i++) {

        if (alunos[i].id == id) {

            for (j = i; j < total - 1; j++) {
                alunos[j] = alunos[j + 1];
            }

            total--;

            printf("\nAluno excluido com sucesso!\n");

            return;
        }
    }

    printf("\nAluno nao encontrado.\n");
}

// MENU PRINCIPAL
int main() {

    int opcao;

    do {

        printf("\n========= SISTEMA ESCOLAR =========\n");
        printf("1 - Cadastrar aluno\n");
        printf("2 - Listar alunos\n");
        printf("3 - Localizar aluno\n");
        printf("4 - Alterar aluno\n");
        printf("5 - Excluir aluno\n");
        printf("0 - Sair\n");

        printf("\nEscolha: ");
        scanf("%d", &opcao);

        switch(opcao) {

            case 1:
                cadastrarAluno();
                break;

            case 2:
                listarAlunos();
                break;

            case 3:
                localizarAluno();
                break;

            case 4:
                alterarAluno();
                break;

            case 5:
                excluirAluno();
                break;

            case 0:
                printf("\nEncerrando sistema...\n");
                break;

            default:
                printf("\nOpcao invalida!\n");
        }

    } while(opcao != 0);

    return 0;
}
