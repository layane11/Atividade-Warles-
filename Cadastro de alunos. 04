#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100
#define MAX_BANCOS 20

// ==================== ESTRUTURAS ====================

struct Pessoa {

    int id;
    char nome[100];
    int idade;
    char info[100];
};

struct Banco {

    char nomeBanco[100];
    char arquivo[100];

    struct Pessoa pessoas[MAX];

    int total;
};

// ==================== BANCOS ====================

struct Banco bancos[MAX_BANCOS];

int totalBancos = 0;

// ==================== CRIAR BANCO ====================

void criarBanco(
    char nome[],
    char arquivo[]
) {

    if(totalBancos >= MAX_BANCOS) {

        printf("\nLimite de bancos atingido!\n");
        return;
    }

    strcpy(
        bancos[totalBancos].nomeBanco,
        nome
    );

    strcpy(
        bancos[totalBancos].arquivo,
        arquivo
    );

    bancos[totalBancos].total = 0;

    totalBancos++;
}

// ==================== NOVO BANCO ====================

void criarNovoBanco() {

    char nome[100];
    char arquivo[100];

    getchar();

    printf("\nNome do novo banco: ");

    fgets(nome, 100, stdin);

    nome[
        strcspn(nome, "\n")
    ] = '\0';

    sprintf(
        arquivo,
        "%s.txt",
        nome
    );

    criarBanco(
        nome,
        arquivo
    );

    FILE *file = fopen(
        arquivo,
        "w"
    );

    if(file != NULL) {

        fclose(file);
    }

    printf(
        "\nBanco criado com sucesso!\n"
    );
}

// ==================== SALVAR ====================

void salvarDadosTXT(struct Banco *banco) {

    FILE *file = fopen(
        banco->arquivo,
        "w"
    );

    int i;

    if(file == NULL) {

        printf(
            "\nErro ao salvar arquivo!\n"
        );

        return;
    }

    for(i = 0; i < banco->total; i++) {

        fprintf(
            file,
            "%d;%s;%d;%s\n",
            banco->pessoas[i].id,
            banco->pessoas[i].nome,
            banco->pessoas[i].idade,
            banco->pessoas[i].info
        );
    }

    fclose(file);
}

// ==================== CARREGAR ====================

void carregarDadosTXT(struct Banco *banco) {

    FILE *file = fopen(
        banco->arquivo,
        "r"
    );

    if(file == NULL) {

        file = fopen(
            banco->arquivo,
            "w"
        );

        fclose(file);

        return;
    }

    banco->total = 0;

    while(
        fscanf(
            file,
            "%d;%99[^;];%d;%99[^\n]\n",
            &banco->pessoas[banco->total].id,
            banco->pessoas[banco->total].nome,
            &banco->pessoas[banco->total].idade,
            banco->pessoas[banco->total].info
        ) == 4
    ) {

        banco->total++;

        if(banco->total >= MAX) {
            break;
        }
    }

    fclose(file);
}

// ==================== DADOS PADRAO ====================

void adicionarDadosPadrao(
    struct Banco *banco
) {

    if(banco->total > 0) {
        return;
    }

    if(
        strcmp(
            banco->nomeBanco,
            "ALUNOS"
        ) == 0
    ) {

        banco->pessoas[0] =
        (struct Pessoa){1, "Ana", 16, "INF1"};

        banco->pessoas[1] =
        (struct Pessoa){2, "Carlos", 17, "INF2"};

        banco->total = 2;
    }

    else if(
        strcmp(
            banco->nomeBanco,
            "PACIENTES"
        ) == 0
    ) {

        banco->pessoas[0] =
        (struct Pessoa){1, "Marcos", 45, "Diabetes"};

        banco->pessoas[1] =
        (struct Pessoa){2, "Julia", 32, "Pressao Alta"};

        banco->total = 2;
    }

    salvarDadosTXT(banco);
}

// ==================== CADASTRAR ====================

void cadastrar(struct Banco *banco) {

    if(banco->total >= MAX) {

        printf("\nLimite atingido!\n");
        return;
    }

    printf(
        "\n======= CADASTRAR =======\n"
    );

    banco->pessoas[banco->total].id =
    banco->total + 1;

    getchar();

    printf("Nome: ");

    fgets(
        banco->pessoas[banco->total].nome,
        100,
        stdin
    );

    banco->pessoas[banco->total].nome[
        strcspn(
            banco->pessoas[banco->total].nome,
            "\n"
        )
    ] = '\0';

    printf("Idade: ");

    scanf(
        "%d",
        &banco->pessoas[banco->total].idade
    );

    getchar();

    printf("Informacao extra: ");

    fgets(
        banco->pessoas[banco->total].info,
        100,
        stdin
    );

    banco->pessoas[banco->total].info[
        strcspn(
            banco->pessoas[banco->total].info,
            "\n"
        )
    ] = '\0';

    banco->total++;

    salvarDadosTXT(banco);

    printf(
        "\nCadastro realizado!\n"
    );
}

// ==================== LISTAR ====================

void listar(struct Banco *banco) {

    int i;

    if(banco->total == 0) {

        printf(
            "\nNenhum cadastro encontrado.\n"
        );

        return;
    }

    printf(
        "\n=========== %s ===========\n",
        banco->nomeBanco
    );

    printf(
        "%-5s %-25s %-10s %-30s\n",
        "ID",
        "NOME",
        "IDADE",
        "INFO"
    );

    printf(
        "------------------------------------------------------------\n"
    );

    for(i = 0; i < banco->total; i++) {

        printf(
            "%-5d %-25s %-10d %-30s\n",
            banco->pessoas[i].id,
            banco->pessoas[i].nome,
            banco->pessoas[i].idade,
            banco->pessoas[i].info
        );
    }
}

// ==================== LOCALIZAR ====================

void localizar(struct Banco *banco) {

    char busca[100];

    int i;
    int encontrado = 0;

    getchar();

    printf("\nDigite o nome: ");

    fgets(
        busca,
        100,
        stdin
    );

    busca[
        strcspn(busca, "\n")
    ] = '\0';

    for(i = 0; i < banco->total; i++) {

        if(
            strstr(
                banco->pessoas[i].nome,
                busca
            ) != NULL
        ) {

            printf(
                "\n======= ENCONTRADO =======\n"
            );

            printf(
                "ID: %d\n",
                banco->pessoas[i].id
            );

            printf(
                "Nome: %s\n",
                banco->pessoas[i].nome
            );

            printf(
                "Idade: %d\n",
                banco->pessoas[i].idade
            );

            printf(
                "Info: %s\n",
                banco->pessoas[i].info
            );

            encontrado = 1;
        }
    }

    if(!encontrado) {

        printf(
            "\nCadastro nao encontrado.\n"
        );
    }
}

// ==================== EXCLUIR ====================

void excluir(struct Banco *banco) {

    int id;
    int i;
    int j;

    printf("\nDigite o ID: ");

    scanf("%d", &id);

    for(i = 0; i < banco->total; i++) {

        if(
            banco->pessoas[i].id == id
        ) {

            for(
                j = i;
                j < banco->total - 1;
                j++
            ) {

                banco->pessoas[j] =
                banco->pessoas[j + 1];
            }

            banco->total--;

            for(
                j = 0;
                j < banco->total;
                j++
            ) {

                banco->pessoas[j].id =
                j + 1;
            }

            salvarDadosTXT(banco);

            printf(
                "\nCadastro removido!\n"
            );

            return;
        }
    }

    printf("\nID nao encontrado.\n");
}

// ==================== MENU DO BANCO ====================

void menuBanco(struct Banco *banco) {

    int opcao;

    do {

        printf(
            "\n======= BANCO %s =======\n",
            banco->nomeBanco
        );

        printf("1 - Cadastrar\n");
        printf("2 - Listar\n");
        printf("3 - Localizar\n");
        printf("4 - Excluir\n");
        printf("0 - Voltar\n");

        printf("\nEscolha: ");

        scanf("%d", &opcao);

        switch(opcao) {

            case 1:
                cadastrar(banco);
                break;

            case 2:
                listar(banco);
                break;

            case 3:
                localizar(banco);
                break;

            case 4:
                excluir(banco);
                break;

            case 0:
                break;

            default:
                printf(
                    "\nOpcao invalida!\n"
                );
        }

    } while(opcao != 0);
}

// ==================== MAIN ====================

int main() {

    int opcao;
    int i;

    // BANCOS PADROES

    criarBanco(
        "ALUNOS",
        "alunos.txt"
    );

    criarBanco(
        "PACIENTES",
        "pacientes.txt"
    );

    criarBanco(
        "FUNCIONARIOS",
        "funcionarios.txt"
    );

    criarBanco(
        "PROFESSORES",
        "professores.txt"
    );

    // CARREGAR DADOS

    for(i = 0; i < totalBancos; i++) {

        carregarDadosTXT(
            &bancos[i]
        );

        adicionarDadosPadrao(
            &bancos[i]
        );
    }

    // MENU PRINCIPAL

    do {

        printf(
            "\n====================================\n"
        );

        printf(
            "         SISTEMA CENTRAL\n"
        );

        printf(
            "====================================\n"
        );

        for(i = 0; i < totalBancos; i++) {

            printf(
                "%d - Banco de %s\n",
                i + 1,
                bancos[i].nomeBanco
            );
        }

        printf(
            "%d - Criar Novo Banco\n",
            totalBancos + 1
        );

        printf("0 - Sair\n");

        printf("\nEscolha: ");

        scanf("%d", &opcao);

        if(
            opcao >= 1 &&
            opcao <= totalBancos
        ) {

            menuBanco(
                &bancos[opcao - 1]
            );
        }

        else if(
            opcao == totalBancos + 1
        ) {

            criarNovoBanco();
        }

        else if(opcao != 0) {

            printf(
                "\nOpcao invalida!\n"
            );
        }

    } while(opcao != 0);

    printf(
        "\nSistema encerrado.\n"
    );

    return 0;
}
